:12px;font-weight:680}.stat .v{position:relative;z-index:1;margin-top:7px;font-size:30px;line-height:1;font-weight:780;letter-spacing:-.045em}.stat .s{position:relative;z-index:1;margin-top:8px;color:var(--faint);font-size:12px}.stat.profit{--glow:rgba(50,213,131,.13)}.stat.alerts{--glow:rgba(255,102,119,.11)}\n.primary-grid,.secondary-grid{display:grid;grid-template-columns:minmax(0,2fr) minmax(300px,1fr);gap:18px;align-items:start}.primary-grid{margin-bottom:30px}.secondary-grid{margin-top:30px}.side-stack{display:grid;gap:16px}\n.panel{background:rgba(16,23,34,.9);border:1px solid var(--line);border-radius:18px;box-shadow:var(--shadow)}.panel-pad{padding:20px}.section-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:14px}.section-head h2,.sect{margin:0;color:var(--txt);font-size:18px;line-height:1.3;font-weight:730;letter-spacing:-.018em;text-transform:none}.section-head p{margin:5px 0 0;color:var(--mut);font-size:13px}.count{display:inline-flex;align-items:center;justify-content:center;min-width:27px;height:27px;border-radius:999px;background:rgba(91,140,255,.13);color:var(--blue2);font-size:12px;font-weight:760}\n.signals{display:grid;gap:10px}.signal{position:relative;padding:18px 18px 16px;background:linear-gradient(135deg,rgba(21,31,45,.98),rgba(16,23,34,.98));border:1px solid var(--line);border-radius:14px;overflow:hidden}.signal::before{content:"";position:absolute;inset:0 auto 0 0;width:3px;background:var(--tone,var(--green))}.signal.live-signal{--tone:var(--red)}.signal.anti{--tone:var(--violet)}.signal-head,.mrow{display:flex;align-items:flex-start;justify-content:space-between;gap:14px}.signal-kicker{display:flex;align-items:center;gap:8px;margin-bottom:4px;color:var(--faint);font-size:12px}.signal h3,.team{margin:0;font-size:16px;line-height:1.35;font-weight:720;overflow-wrap:anywhere}.badge{display:inline-flex;align-items:center;gap:6px;min-height:25px;padding:4px 9px;border-radius:999px;white-space:nowrap