#!/usr/bin/env python3
"""Phase 2B — 'goal expected' signal v2 (council-tuned 2026-07-11). Reads sofa_live.json +
sofa_live_history.jsonl. Improvements over v1 (per 4-AI council consensus):
  • Poisson model prob p=1-e^-λ (≥1 or ≥2 more goals) → FAIR odds → min bettable odds (real +EV gate,
    user confirms winline coef ≥ min; ≥4% edge over fair, never the 1.05-1.15 junk zone).
  • Early (25-57') vs late (58-85') split: early targets 'ещё 2 гола' (ТБ тек+1.5, thicker odds);
    late targets 'ещё гол' (ТБ тек+0.5). Kills near-certain thin-edge early Over-0.5 bets.
  • Shot confirmation: xG burst must be backed by a shot on target or big chance (no lone-fluke xG).
  • Game-state filter: skip blowouts (leader by ≥2 = kill-time, low urgency).
  • Dedup by SCORELINE not timer: one signal per match per score → mutes the Dundalk 3x spam,
    re-arms only when a goal changes the score.
  • Confidence tier A/B + logs p_model/fair/min/need_goals for CLV & backtest.
Sends to the dedicated bot (data/sofa_tg.json). Odds auto-scrape + low-league Attack-Momentum = phase 3."""
from __future__ import annotations
import json, math, sys
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parent
LIVE = ROOT / "data" / "sofa_live.json"
HIST = ROOT / "data" / "sofa_live_history.jsonl"
LOG = ROOT / "data" / "sofa_signal_log.jsonl"
SEEN = ROOT / "data" / "sofa_signal_seen.json"
sys.path.insert(0, str(ROOT))

WIN_MIN, WIN_MAX = 25, 85     # actionable window
EARLY_MAX = 57                # <= this = 'early' (target 2 more goals)
XG_STRONG = 0.45             # early needs a strong burst
XG_MOD = 0.30                # late moderate burst
EDGE = 1.04                  # require live odds >= fair * this (>=4% edge)
P_MIN, P_MAX = 0.05, 0.90    # skip degenerate probabilities (too long / too short)


def _read(p):
    return [json.loads(l) for l in p.read_text(encoding="utf-8").splitlines() if l.strip()] if p.exists() else []


def _tot(r, k):
    return (r.get(k + "_h") or 0) + (r.get(k + "_a") or 0)


def _recent(mid, cur_min, hist, key, window=12):
    """Total of `key` (both teams) ~window minutes ago for match mid, or None."""
    past = [h for h in hist if h.get("id") == mid and h.get("minute") is not None
            and 3 <= (cur_min - h["minute"]) <= window and h.get(key + "_h") is not None]
    if not past:
        return None
    p = min(past, key=lambda h: h["minute"])
    return (p.get(key + "_h") or 0) + (p.get(key + "_a") or 0)


def _send_tg(msg):
    """Отправка сигнала на выделенный SofaScore-бот (data/sofa_tg.json)."""
    import json as _j, urllib.request as _u, urllib.parse as _p
    cfg = _j.loads((ROOT / "data" / "sofa_tg.json").read_text(encoding="utf-8"))
    data = _p.urlencode({"chat_id": cfg["chat_id"], "text": msg,
                         "parse_mode": "HTML", "disable_web_page_preview": "true"}).encode()
    _u.urlopen("https://api.telegram.org/bot%s/sendMessage" % cfg["token"], data=data, timeout=15)


def _p_ge1(lam):
    return 1 - math.exp(-lam)


def _p_ge2(lam):
    return 1 - math.exp(-lam) - lam * math.exp(-lam)


def main(dry=False):
    try:
        live = json.loads(LIVE.read_text(encoding="utf-8"))
    except Exception:  # noqa: BLE001
        print("no sofa_live.json"); return
    hist = _read(HIST)
    try:
        seen = json.loads(SEEN.read_text(encoding="utf-8")) if SEEN.exists() else {}
    except Exception:  # noqa: BLE001
        seen = {}
    fired = 0
    for r in live.get("matches", []):
        mid, minute = r.get("id"), r.get("minute")
        sh, sa = r.get("sh"), r.get("sa")
        if r.get("xg_h") is None or minute is None or sh is None or sa is None:
            continue                                   # only xG-covered matches
        if not (WIN_MIN <= minute <= WIN_MAX):
            continue
        if abs(sh - sa) >= 2:
            continue                                   # blowout = kill-time, low urgency

        cur_xg = _tot(r, "xg")
        past_xg = _recent(mid, minute, hist, "xg", 12)
        if past_xg is None:
            continue
        recent_xg = cur_xg - past_xg
        past_sot = _recent(mid, minute, hist, "sot", 12)
        recent_sot = (_tot(r, "sot") - past_sot) if past_sot is not None else 0
        past_big = _recent(mid, minute, hist, "bigch", 12)
        recent_big = (_tot(r, "bigch") - past_big) if past_big is not None else 0
        shot_conf = recent_sot >= 1 or recent_big >= 1   # burst must be backed by real threat

        total_now = sh + sa
        avg_rate = cur_xg / max(minute, 1)
        recent_rate = max(0.0, recent_xg) / 10.0
        proj_rate = max(avg_rate, 0.6 * recent_rate + 0.4 * avg_rate)   # momentum-weighted, no wild extrapolation
        rem = max(2, 92 - minute)
        lam = proj_rate * rem

        if minute <= EARLY_MAX:
            if recent_xg < XG_STRONG or not shot_conf:
                continue
            need, p = 2, _p_ge2(lam)
            line = total_now + 1.5
            market = f"ТБ {line:.1f} (ещё 2 гола до конца)"
            pace_lbl = "ещё 2 гола"
        else:
            if recent_xg < XG_MOD or not shot_conf:
                continue
            need, p = 1, _p_ge1(lam)
            line = total_now + 0.5
            market = f"ТБ {line:.1f} (ещё гол до конца)"
            pace_lbl = "ещё гол"

        if not (P_MIN <= p <= P_MAX):
            continue                                   # skip too-short / too-long

        fair = 1.0 / p
        minbet = fair * EDGE
        tier = "A" if (recent_xg >= XG_STRONG and recent_big >= 1) else "B"

        # dedup by scoreline: one signal per match per score (re-arms on a goal)
        key = str(mid)
        score_key = f"{sh}-{sa}"
        if seen.get(key) == score_key:
            continue

        msg = (f"⚽ <b>Ожидается гол</b> [{tier}] (SofaScore live-xG) — {r['home']} vs {r['away']}\n"
               f"   {r.get('tourn','')} | счёт {sh}:{sa} {minute}'\n"
               f"   момент: <b>+{recent_xg:.2f} xG за ~10мин</b> | удары в створ +{recent_sot:.0f} | big +{recent_big:.0f}\n"
               f"   модель: p({pace_lbl}) = <b>{p*100:.0f}%</b> → честный коэф <b>{fair:.2f}</b>\n"
               f"   → рынок: <b>{market}</b>\n"
               f"   Бери на winline ТОЛЬКО если коэф ≥ <b>{minbet:.2f}</b> (край ≥4% над честным)")
        print(msg.replace("<b>", "").replace("</b>", ""))
        if not dry:
            try:
                _send_tg(msg)
            except Exception as e:  # noqa: BLE001
                print("tg fail:", e)
            with LOG.open("a", encoding="utf-8") as f:
                f.write(json.dumps({"id": mid, "home": r["home"], "away": r["away"], "minute": minute,
                                    "score": score_key, "tot_goals": total_now, "need_goals": need,
                                    "market": market, "p_model": round(p, 4), "fair": round(fair, 3),
                                    "min_odds": round(minbet, 3), "tier": tier,
                                    "recent_xg": round(recent_xg, 3), "recent_sot": recent_sot,
                                    "recent_big": recent_big, "tourn": r.get("tourn"),
                                    "logged_at": datetime.now(timezone.utc).isoformat()}, ensure_ascii=False) + "\n")
        seen[key] = score_key
        fired += 1
    if not dry:
        SEEN.write_text(json.dumps(seen), encoding="utf-8")
    print(f"signals fired: {fired}")


if __name__ == "__main__":
    main(dry="--dry" in sys.argv)
